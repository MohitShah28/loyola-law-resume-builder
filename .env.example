GROQ_API_KEY=your_groq_api_key_here
# Optional: add a second key, or use GROQ_API_KEYS for a comma-separated fallback list.
GROQ_API_KEY_2=
# GROQ_API_KEYS=first_key_here,second_key_here
GROQ_API_ENABLED=true
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_API_ENABLED=true
GEMINI_MODEL=gemini-3.5-flash

# Optional: Claude API (paid, best quality — tried first when configured).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_ENABLED=true
ANTHROPIC_MODEL=claude-opus-4-8

# Optional Google Custom Search enrichment for public job/company context.
GOOGLE_SEARCH_ENABLED=true
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
