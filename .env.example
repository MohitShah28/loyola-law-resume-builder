GROQ_API_KEY=your_groq_api_key_here
# Optional: add a second key, or use GROQ_API_KEYS for a comma-separated fallback list.
GROQ_API_KEY_2=
# GROQ_API_KEYS=first_key_here,second_key_here
GROQ_API_ENABLED=true
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_API_ENABLED=true
# Best first; the first model your plan can use wins (Pro needs billing).
GEMINI_MODEL=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash

# Optional: OpenRouter, the backup when Claude and Gemini fail or hit their limits.
# A free key (openrouter.ai) runs free models only, 50 requests a day.
OPENROUTER_API_KEY=
OPENROUTER_API_ENABLED=true
# Up to 3 models, best first (defaults to free models; see lib/openrouter.ts).
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,qwen/qwen3.8-27b:free,openrouter/free

# Optional: Claude API (paid, best quality — tried first when configured).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_ENABLED=true
ANTHROPIC_MODEL=claude-opus-5

# Optional Google Custom Search enrichment for public job/company context.
GOOGLE_SEARCH_ENABLED=true
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
